# HostVille • BOT — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env.

# ─── Bot ──────────────────────────────────────────────────────
TOKEN=
CLIENT_ID=
OWNER_ID=
LOG_CHANNEL_ID=

# ─── Staff (lista separada por vírgula) ───────────────────────
ADMIN_ROLES=
STAFF_USER_ID=
APPROVE_ROLE=

# ─── Acesso ───────────────────────────────────────────────────
ACCESS_CODE=

# ─── Kilo (gateway de IA) ─────────────────────────────────────
KILO_API_KEY=
KILO_API_KEYS=
KILO_BASE_URL=https://ai-gateway.kilo.ai/api/v1
KILO_DEFAULT_MODEL=provedor/modelo
KILO_FALLBACK_MODEL=

# ─── Modelos dedicados (vazio = usa KILO_DEFAULT_MODEL) ───────
GUARD_MODEL=
MODERATION_MODEL=

# ─── Honeypot ─────────────────────────────────────────────────
HONEYPOT_ENABLED=false
HONEYPOT_CHANNEL_ID=
HONEYPOT_ALERT_CHANNEL_ID=
HONEYPOT_MEDIA_CHANNEL_ID=
HONEYPOT_GUILD_ID=

# ─── Anti-raid ────────────────────────────────────────────────
ANTI_RAID_ENABLED=false
ANTI_RAID_GUILD_ID=
ANTI_RAID_ALERT_CHANNEL_ID=
ANTI_RAID_TRUSTED=

# ─── Auto-KB ──────────────────────────────────────────────────
AUTO_KB_ENABLED=false
AUTO_KB_GUILD=
AUTO_KB_CANAL=

# ─── Análise de imagem ────────────────────────────────────────
IMAGE_ANALYZER_ENABLED=false
IMAGE_ANALYZER_CHANNEL_ID=
IMAGE_ANALYZER_MODEL=
IMAGE_ANALYZER_MAX_TOKENS=1200
IMAGE_ANALYZER_TIMEOUT_MS=60000

# ─── Realtime (Pusher) ────────────────────────────────────────
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# ─── Memória ──────────────────────────────────────────────────
MONGO_URI=

# ─── Ajuste fino do gateway ───────────────────────────────────
KILO_MAX_TOKENS=8000
KILO_MIN_TOKENS=1200
KILO_TEMPERATURE=0.7
KILO_TOP_P=0.9
KILO_TIMEOUT_MS=300000
KILO_MAX_CONCURRENCY=2
KILO_MAX_RETRIES=1

# ─── Moderação ────────────────────────────────────────────────
MODERATION_ENABLED=true
MODERATION_MAX_TOKENS=
MODERATION_TIMEOUT_MS=

# ─── Geração de código ────────────────────────────────────────
TASK_MAX_TOKENS=8000
